actor LMGUpgraded : inventory {Inventory.MaxAmount 1}

actor PBX_LMGEdited : PB_LMG
{
	Inventory.AltHudIcon "LMPIA0"

    States
    {
		Select:
			TNT1 A 0 A_TakeInventory("PB_LMG")
			goto super::Select

        WeaponSpecial:
            TNT1 A 0 {
				A_SetInventory("CantWeaponSpecial",1);
				A_SetInventory("GoWeaponSpecialAbility",0);
			}
            TNT1 A 0 {
				// If there is no upgrade and the lmg edit is true and the weapon edits are enabled, then print the message and return to ready3 state
				if(!(findinventory("LMGUpgraded")) && !(PBX_Weapons_WeaponEditsFlags & DisablePBX_LMGEdit) && PBX_Weapons_EnableWeaponEdits)
				{
					A_Print("$PBX_Weapons_LMGUpgrade_NoUpgrade");
					return resolvestate("ready3");
				}
				return resolvestate("");
			}
            goto super::WeaponSpecial
    }
}