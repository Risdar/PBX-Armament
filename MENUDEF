AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBX_Armament_Settings", "PBX_Armament_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Weapons Settings ---------", 1
    Option "$PBX_Weapons_MENU_ENABLE_TOOLTIPS", "PBX_Armament_SendTip", "OnOff","PBXCore_SendTip"
    Option "$PBX_Weapons_MENU_ENABLE_KEEPWEAPONS", "PBX_Weapons_keepweapons", "OnOff"
    SafeCommand "$PBX_Weapons_MENU_RESET_SPAWNERS", "set PBX_Chainsaw_filter 0; set PBX_Pistol_filter 0; set PBX_Shotgun_filter 0; set PBX_SSG_filter 0; set PBX_Chaingun_filter 0; set PBX_RocketLauncher_filter 0; set PBX_Plasma_filter 0; set PBX_BFG_filter 0;set PBX_BackPack_filter 0;set PBX_MonsterWeapon_filter 0;set PBX_SecretWeapon_filter 0; set PBX_WPEdit_filter 0;"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBTOOLTIPS", "set pb_helpflags 0"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBX_Weapons_TOOLTIPS", "set PBX_Armament_weaponTipFlags 0; set PBX_Armament_upgradeTipFlags 0"
    StaticText "$PBX_Armament_Version",red
    StaticText " "
}

OptionMenu "PBX_Armament_Menu"
{
    Title "$PBX_Armament_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option "$PBX_Weapons_MENU_ENABLE_TOOLTIPS", "PBX_Armament_SendTip", "OnOff","PBXCore_SendTip"
    Option "$PBX_Weapons_MENU_ENABLE_KEEPWEAPONS", "PBX_Weapons_keepweapons", "OnOff"
    StaticText " "
    SafeCommand "$PBX_Weapons_MENU_RESET_SPAWNERS", "set PBX_Chainsaw_filter 0; set PBX_Pistol_filter 0; set PBX_Shotgun_filter 0; set PBX_SSG_filter 0; set PBX_Chaingun_filter 0; set PBX_RocketLauncher_filter 0; set PBX_Plasma_filter 0; set PBX_BFG_filter 0;set PBX_BackPack_filter 0;set PBX_MonsterWeapon_filter 0;set PBX_SecretWeapon_filter 0; set PBX_WPEdit_filter 0;"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBTOOLTIPS", "set pb_helpflags 0"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBX_Weapons_TOOLTIPS", "set PBX_Armament_weaponTipFlags 0; set PBX_Armament_upgradeTipFlags 0"
    StaticText " "
    StaticText	"--------- Weapon Settings ---------", 1
    Option "$PBX_Weapons_START_WITH_BDP_RIFLE", "PBX_Weapons_startwithnormalrifle", "OnOff"
    Option "$PBX_Weapons_START_WITH_CROSSBOW", "PBX_Weapons_startwithcrossbow", "OnOff"
    Option "$PBX_Weapons_CSSG_LOCK_SWITCH", "PBX_Weapons_cssghooklockswitch", "OnOff"
    Option "$PBX_Weapons_LASER_SHOW_BEAM", "PBX_Weapons_lasershowbeam", "OnOff"
    StaticText " "
    Option "$PBX_Weapons_MENU_SECRETWEAPON_ENABLE", "PBX_SecretWeapon_Enable", "OnOff"
    Option "$PBX_Weapons_MENU_SECRETWEAPON_BFGSPAWN", "PBX_SecretWeapon_BFGSpawn", "OnOff"
    Slider "$PBX_Weapons_SECRETWEAPONS_SPAWNCHANCE",  "PBX_SecretWeapon_Chance",     1, 100, 1,0,"PBX_SecretWeapon_Enable"
    StaticText " "
    Slider "$PBX_CSSGMeathook_Cooldown",        "PBX_CSSGMeathook_Cooldown",        1, 500, 1
    Slider "$PBX_RailgunHologram_Cooldown",     "PBX_RailgunHologram_Cooldown",     1, 500, 1
    Slider "$PBX_RailgunHologram_Lifetime",     "PBX_RailgunHologram_Lifetime",     1, 500, 1
    SafeCommand "$PBX_Weapons_MENU_RESET_WEAPON_DURATIONS", "resetcvar PBX_SecretWeapon_Chance; resetcvar PBX_CSSGMeathook_Cooldown; resetcvar PBX_RailgunHologram_Cooldown; resetcvar PBX_RailgunHologram_Lifetime"
    StaticText " "
    StaticText	"--------- Weapon Edits Settings ---------", 1
    Option "$PBX_MENU_WEAPONEDIT_ENABLE", "PBX_WPEdit_Enable", "OnOff"
    StaticText " "
    FlagOption    "$PBX_Weapons_SGL_EDIT",                       "PBX_WPEdit_filter",   "OffOn", 0, "PBX_WPEdit_Enable"
	FlagOption    "$PBX_Weapons_LMG_EDIT",                       "PBX_WPEdit_filter",   "OffOn", 1, "PBX_WPEdit_Enable"
	FlagOption    "$PBX_Weapons_CHAINSAW_EDIT",                  "PBX_WPEdit_filter",   "OffOn", 2, "PBX_WPEdit_Enable"
    StaticText " "
    StaticText	"--------- Backpack Reload Settings ---------", 1
    Option "$PBX_MENU_BACKPACK_RELOAD_ENABLE", "PBX_BackpackReload_Enable", "OnOff"
    StaticText " "
    slider "$PBX_MENU_BACKPACK_RELOAD_FREQ",             "PBBCKPR_Time",1,350,5
    slider "$PBX_MENU_BACKPACK_RELOAD_AMOUNT",           "PBBCKPR_Ref",1,10,1
    option "$PBX_MENU_BACKPACK_RELOAD_ANNOUNCE",         "PBBCKPR_Tell","yesno"

    StaticText " "
    StaticText "$PBX_Armament_Version",red
}


