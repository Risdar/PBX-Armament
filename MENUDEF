//////////////// HUD MENU /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
OptionMenu "PBX_Hud_Menu"
{
    Title "$PBX_MENU_HUD"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- Weapon HUD Settings ---------", 1
    FlagOption "$PBX_MENU_HUD_WEAPONHUD",            "PBXCore_HudFlags",    "OffOn", 0
    Slider     "$PBX_MENU_HUD_HORIZONTAL",        "PBX_CVAR_HUD_WEAPON_X",          -700, 700, 1
    Slider     "$PBX_MENU_HUD_VERTICAL",          "PBX_CVAR_HUD_WEAPON_Y",          -700, 700, 1
    Slider     "$PBX_MENU_HUD_SCALE",                 "PBX_CVAR_HUD_WEAPON_SCALE",      0.1, 10, 0.1
    Slider     "$PBX_MENU_HUD_TRANSPARENCY",	        "PBX_CVAR_HUD_WEAPON_ALPHA",      0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBX_CVAR_HUD_WEAPON_BOX_W",       1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBX_CVAR_HUD_WEAPON_BOX_H",       1, 250, 1 */
    StaticText " "
    FlagOption "$PBX_MENU_HUD_WEAPONMODEHUD",       "PBXCore_HudFlags",    "OffOn", 1
    Slider     "$PBX_MENU_HUD_HORIZONTAL",        "PBX_CVAR_HUD_WEAPON_MODE_HUD_X",      -700, 700, 1
    Slider     "$PBX_MENU_HUD_VERTICAL",          "PBX_CVAR_HUD_WEAPON_MODE_HUD_Y",      -700, 700, 1
    Slider     "$PBX_MENU_HUD_SCALE",                 "PBX_CVAR_HUD_WEAPON_MODE_HUD_SCALE",  0.1, 10, 0.1
    Slider     "$PBX_MENU_HUD_TRANSPARENCY",	        "PBX_CVAR_HUD_WEAPON_MODE_HUD_ALPHA",  0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBX_CVAR_HUD_WEAPON_MODE_HUD_BOX_W",   1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBX_CVAR_HUD_WEAPON_MODE_HUD_BOX_H",   1, 250, 1 */
    StaticText " "
    StaticText	"--------- Armor HUD Settings ---------", 1
    FlagOption "$PBX_MENU_HUD_ARMORHUD",             "PBXCore_HudFlags",    "OffOn", 2
    FlagOption "$PBX_MENU_HUD_ARMORHUD_BACKGROUND",  "PBXCore_HudFlags",    "OffOn", 3
    Slider     "$PBX_MENU_HUD_HORIZONTAL",        "PBX_CVAR_HUD_ARMOR_X",      -700, 700, 1
    Slider     "$PBX_MENU_HUD_VERTICAL",          "PBX_CVAR_HUD_ARMOR_Y",      -700, 700, 1
    Slider     "$PBX_MENU_HUD_SCALE",                 "PBX_CVAR_HUD_ARMOR_SCALE",  0.1, 10, 0.1
    Slider     "$PBX_MENU_HUD_TRANSPARENCY",	        "PBX_CVAR_HUD_ARMOR_ALPHA",  0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBX_CVAR_HUD_ARMOR_BOX_W",   1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBX_CVAR_HUD_ARMOR_BOX_H",   1, 250, 1 */
    StaticText " "
    // Reset
    StaticText	"--------- Reset to Defaults ---------", 1
    SafeCommand  "$PBXCORE_HUD_RESET", "set PBXCore_HudFlags 0"
    SafeCommand  "$PBXCORE_WEAPONHUD_RESET", "resetcvar PBX_CVAR_HUD_WEAPON_X; resetcvar PBX_CVAR_HUD_WEAPON_Y; resetcvar PBX_CVAR_HUD_WEAPON_SCALE; resetcvar PBX_CVAR_HUD_WEAPON_ALPHA; resetcvar PBX_CVAR_HUD_WEAPON_BOX_W; resetcvar PBX_CVAR_HUD_WEAPON_BOX_H"
    SafeCommand  "$PBXCORE_WEAPONMODEHUD_RESET", "resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_X; resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_Y; resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_SCALE; resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_ALPHA; resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_BOX_W; resetcvar PBX_CVAR_HUD_WEAPON_MODE_HUD_BOX_H"
    SafeCommand  "$PBXCORE_ARMORHUD_RESET", "resetcvar PBX_CVAR_HUD_ARMOR_X; resetcvar PBX_CVAR_HUD_ARMOR_Y; resetcvar PBX_CVAR_HUD_ARMOR_SCALE; resetcvar PBX_CVAR_HUD_ARMOR_ALPHA; resetcvar PBX_CVAR_HUD_ARMOR_BOX_W; resetcvar PBX_CVAR_HUD_ARMOR_BOX_H"
    StaticText " "
    StaticText "$PBX_VERSION",cyan
}

//////////////// GAMEPLAY MENU /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
OptionMenu "PBX_Gameplay_Menu"
{
    Title "$PBX_MENU_GAMEPLAY"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- Smart Scavenger Settings ---------", 1
    Option "$PBX_MENU_SMARTSCAV",                       "PBX_CVAR_SMARTSCAV", "OnOff"
    StaticText " "

    StaticText	"--------- Helmet Drops Settings ---------", 1
    Option "$PBX_MENU_HELMETDROPS",                     "PBX_CVAR_HELMETDROPS", "OnOff"
    StaticText " "

    StaticText	"--------- Hit Feedback Settings ---------", 1
    Option "$PBX_MENU_HF",                              "PBX_CVAR_HF", "OnOff", "PBX_COMPAT_ULTIMATEVISOR", 0, 1
    StaticText " "

    StaticText	"--------- Backpack Reload Settings ---------", 1
    Option "$PBX_MENU_BACKPACK_RELOAD_ENABLE",          "PBX_CVAR_BCKPR", "OnOff"
    StaticText " "
    slider "$PBX_MENU_BACKPACK_RELOAD_FREQ",             "PBBCKPR_Time",1,350,5
    slider "$PBX_MENU_BACKPACK_RELOAD_AMOUNT",           "PBBCKPR_Ref",1,10,1
    option "$PBX_MENU_BACKPACK_RELOAD_ANNOUNCE",         "PBBCKPR_Tell","yesno"
    StaticText " "

    StaticText " "
    StaticText	"--------- Damage Indicators Settings ---------", 1
    Option "$PBX_MENU_DD",                        "PBX_CVAR_DD", "OnOff"
    StaticText " "
    option "$PBX_MENU_DD_TYPE",                   "D4D_IndicatorType","D4DIndTypes"
	option "$PBX_MENU_DD_COLORED", 				  "D4D_NoColorType","NoYes"
	slider "$PBX_MENU_DD_SCALE",                  "D4D_DIScale",0.2,1.0,0.05
	slider "$PBX_MENU_DD_ALPHA",                  "D4D_DIAlpha",0.05,1.0,0.05
	slider "$PBX_MENU_DD_DURATION",               "D4D_DITimer",20,140,5
	option "$PBX_MENU_DD_ANIMATION",              "D4D_DIAnim","D4DAnimTypes"
    StaticText " "
    StaticText	"--------- Damage Indicator Default Color ---------", 1
	colorpicker "$PBX_MENU_DD_COLORPICKER",       "D4D_DefColor"
	textfield "$PBX_MENU_DD_HEX",                 "D4D_DefColor"
    StaticText " "

    StaticText " "
    StaticText	"--------- Damage Flash Settings ---------", 1
    ScaleSlider "$PBX_MENU_DF_DURATION",                 "OuchFlashDuration", 0, 35, 1, "Disabled", "????? HOW IS IT -1"
	ScaleSlider "$PBX_MENU_DF_COOLDOWN",                 "OuchFlashCooldown", 0, 35, 1, "Disabled", "what", "OuchFlashDuration", 0
	Option      "$PBX_MENU_DF_ACTOR_TYPES",              "OuchFlashOnlyMonsters", "OuchFlashActorType", "OuchFlashDuration", 0
	Slider      "$PBX_MENU_DF_MIN_DAMAGE",               "OuchFlashMinDamage", 1, 100, 5, 0, "OuchFlashDuration", 0
	ScaleSlider "$PBX_MENU_DF_EXTRA_BRIGHT",             "OuchFlashBrightness", 0, 255, 32, "Disabled", "what", "OuchFlashDuration", 0
	Option      "$PBX_MENU_DF_FLASH_TYPE",               "OuchFlashSolidColor", "OuchFlashType", "OuchFlashDuration", 0
	StaticText " "
	ColorPicker "$PBX_MENU_DF_DEFAULT_COLOR",            "OuchFlash_Default", "OuchFlashDuration", 0
	StaticText " "
    StaticText	"--------- ZDoom Damage Types ---------", 1
	ColorPicker "$PBX_MENU_DF_HITSCAN", 			  	"OuchFlash_Hitscan", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_BFG_SPLASH", 				"OuchFlash_BFGSplash", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_DROWNING", 				"OuchFlash_Drowning", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_SLIME", 				    "OuchFlash_Slime", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_FIRE", 					"OuchFlash_Fire", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_CRUSH", 					"OuchFlash_Crush", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_TELEFRAG", 				"OuchFlash_Telefrag", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_MELEE",			 		"OuchFlash_Melee", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_RAILGUN", 				"OuchFlash_Railgun", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_ICE", 					"OuchFlash_Ice", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_ELECTRIC", 				"OuchFlash_Electric", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_POISON", 					"OuchFlash_Poison", "OuchFlashDuration", 0
