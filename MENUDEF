//////////////// START MENU /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
ListMenu "MainMenu"
{
	Font		"PBBIG",	"red",	"white"
	StaticPatch	160, -2,	"M_DOOMPB",	1
	Position	85, 66
	TextItem	"New Game",	"n",	"PlayerclassMenu"
	Selector	"M_SKULL1",	-30, -8
    
	ifOption(SwapMenu)
	{
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
	}
	else
	{
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
	}
	ifOption(ReadThis)
	{
		TextItem "Read This!","r",	"ReadThisMenu"
	}
	TextItem "Quit Game",	"q",	"QuitMenu"
	Size Clean
}


//////////////// ADDONS MENU /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
AddOptionMenu "PB_AddonOptions"
{
    StaticText " "
    StaticText	"--------- Project Brutality Extended Settings ---------", 1
    Option  "$PBXCORE_DEBUG_MODE", "PBX_DEBUG", "OnOff"
	Option  "$PBXCORE_PRINT_VERSION", "PBX_SHOW_VERSION", "OnOff"
    Option  "$PBXCORE_ENABLE_TOOLTIP", "PBX_SEND_TIP", "OnOff"
    StaticText " "
    SafeCommand "$PBX_MENU_RESET_PBTOOLTIPS", "set pb_helpflags 0"
    SafeCommand "$PBX_MENU_RESET_PBXTOOLTIPS", "set PBX_TIP_FLAGS_WEAPONS 0; set PBX_TIP_FLAGS_UPGRADES 0"
    StaticText " "

    Submenu "$PBX_MENU_WEAPONS", "PBX_Weapons_Menu"
    Submenu "$PBX_MENU_GAMEPLAY", "PBX_Gameplay_Menu"
    Submenu "$PBX_MENU_HUD", "PBX_Hud_Menu"
    StaticText " "
}

//////////////// GAMEPLAY MENU /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
OptionMenu "PBX_Weapons_Menu"
{
    Title "$PBX_MENU_WEAPONS"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- Weapon Settings ---------", 1
    Option "$PBX_MENU_ENABLE_KEEPWEAPONS", "PBX_CVAR_KEEP_WEAPONS", "OnOff"
    StaticText " "
    SafeCommand "$PBX_MENU_RESET_SPAWNERS", "set PBX_SPAWN_FLAGS_CHAINSAW 0; set PBX_SPAWN_FLAGS_PISTOL 0; set PBX_SPAWN_FLAGS_SHOTGUN 0; set PBX_SPAWN_FLAGS_SSG 0; set PBX_SPAWN_FLAGS_CHAINGUN 0; set PBX_SPAWN_FLAGS_ROCKET_LAUNCHER 0; set PBX_SPAWN_FLAGS_PLASMA 0; set PBX_SPAWN_FLAGS_BFG 0;set PBX_SPAWN_FLAGS_BACKPACK 0;set PBX_SPAWN_FLAGS_MONSTER_WEAPONS 0;set PBX_SPAWN_FLAGS_SECRET_WEAPONS 0;set PBX_SPAWN_FLAGS_EQUIPMENTS 0;"
    StaticText " "
    Option "$PBX_MENU_ASSAULT_RIFLE_START", "PBX_CVAR_ASSAULT_RIFLE_START", "OnOff"
    Option "$PBX_MENU_CROSSBOW_START", "PBX_CVAR_CROSSBOW_START", "OnOff"
    Option "$PBX_MENU_LASER_SIGHT_BEAM", "PBX_CVAR_LASER_SIGHT_BEAM", "OnOff"
    StaticText " "
    Option "$PBX_MENU_SECRET_WEAPONS", "PBX_CVAR_SECRET_WEAPONS", "OnOff"
    Slider "$PBX_MENU_SECRET_WEAPONS_SPAWN_CHANCE",  "PBX_CVAR_SECRET_WEAPONS_SPAWN_CHANCE",     1, 100, 1,0,"PBX_CVAR_SECRET_WEAPONS"
    StaticText " "
    Slider "$PBX_MENU_COOLDOWN_MEATHOOK",        "PBX_COOLDOWN_MEATHOOK",        1, 500, 1
    Slider "$PBX_MENU_COOLDOWN_COIN",           "PBX_COOLDOWN_COIN",           1, 500, 1
    SafeCommand "$PBX_MENU_COOLDOWN_RESET", "resetcvar PBX_COOLDOWN_COIN; resetcvar PBX_CVAR_SECRET_WEAPONS_SPAWN_CHANCE; resetcvar PBX_COOLDOWN_MEATHOOK;"
    StaticText " "
}

OptionMenu "PBX_Gameplay_Menu"
{
    Title "$PBX_MENU_GAMEPLAY"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- Hit Feedback Settings ---------", 1
    Option "$PBX_MENU_HF",                        "PBX_CVAR_HF", "OnOff","PBX_COMPAT_ULTIMATEVISOR",0,1
    StaticText " "

    StaticText " "
    StaticText	"--------- Damage Indicators Settings ---------", 1
    Option "$PBX_MENU_DD",                        "PBX_CVAR_DD", "OnOff"
    StaticText " "
    option "$PBX_MENU_DD_TYPE",                   "D4D_IndicatorType","D4DIndTypes"
	option "$PBX_MENU_DD_COLORED", 				  "D4D_NoColorType","NoYes"
	slider "$PBX_MENU_DD_SCALE",                  "D4D_DIScale",0.2,1.0,0.05
	slider "$PBX_MENU_DD_ALPHA",                  "D4D_DIAlpha",0.05,1.0,0.05
	slider "$PBX_MENU_DD_DURATION",               "D4D_DITimer",20,140,5
	option "$PBX_MENU_DD_ANIMATION",              "D4D_DIAnim","D4DAnimTypes"
    StaticText " "
    StaticText	"--------- Damage Indicator Default Color ---------", 1
	colorpicker "$PBX_MENU_DD_COLORPICKER",       "D4D_DefColor"
	textfield "$PBX_MENU_DD_HEX",                 "D4D_DefColor"
    StaticText " "

    StaticText " "
    StaticText	"--------- Damage Flash Settings ---------", 1
    ScaleSlider "$PBX_MENU_DF_DURATION",                 "OuchFlashDuration", 0, 35, 1, "Disabled", "????? HOW IS IT -1"
	ScaleSlider "$PBX_MENU_DF_COOLDOWN",                 "OuchFlashCooldown", 0, 35, 1, "Disabled", "what", "OuchFlashDuration", 0
	Option      "$PBX_MENU_DF_ACTOR_TYPES",              "OuchFlashOnlyMonsters", "OuchFlashActorType", "OuchFlashDuration", 0
	Slider      "$PBX_MENU_DF_MIN_DAMAGE",               "OuchFlashMinDamage", 1, 100, 5, 0, "OuchFlashDuration", 0
	ScaleSlider "$PBX_MENU_DF_EXTRA_BRIGHT",             "OuchFlashBrightness", 0, 255, 32, "Disabled", "what", "OuchFlashDuration", 0
	Option      "$PBX_MENU_DF_FLASH_TYPE",               "OuchFlashSolidColor", "OuchFlashType", "OuchFlashDuration", 0
	StaticText " "
	ColorPicker "$PBX_MENU_DF_DEFAULT_COLOR",            "OuchFlash_Default", "OuchFlashDuration", 0
	StaticText " "
    StaticText	"--------- ZDoom Damage Types ---------", 1
	ColorPicker "$PBX_MENU_DF_HITSCAN", 			  	"OuchFlash_Hitscan", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_BFG_SPLASH", 				"OuchFlash_BFGSplash", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_DROWNING", 				"OuchFlash_Drowning", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_SLIME", 				    "OuchFlash_Slime", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_FIRE", 					"OuchFlash_Fire", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_CRUSH", 					"OuchFlash_Crush", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_TELEFRAG", 				"OuchFlash_Telefrag", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_MELEE",			 		"OuchFlash_Melee", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_RAILGUN", 				"OuchFlash_Railgun", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_ICE", 					"OuchFlash_Ice", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_ELECTRIC", 				"OuchFlash_Electric", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_POISON", 					"OuchFlash_Poison", "OuchFlashDuration", 0
	ColorPicker "$PBX_MENU_DF_PLASMA", 					"OuchFlash_Plasma", "OuchFlashDuration", 0
