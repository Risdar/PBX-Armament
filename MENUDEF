AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBX_Armament_Settings", "PBX_Armament_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Weapons Settings ---------", 1
    Option "$PBX_Weapons_MENU_ENABLE_TOOLTIPS", "PBX_Weapons_sendTip", "OnOff","PBXCore_SendTip"
    Option "$PBX_Weapons_MENU_ENABLE_KEEPWEAPONS", "PBX_Weapons_keepweapons", "OnOff"
    SafeCommand "$PBX_Weapons_MENU_RESET_SPAWNERS", "set PBX_Weapons_chainsaw_filter 0; set PBX_Weapons_pistol_filter 0; set PBX_Weapons_shotgun_filter 0; set PBX_Weapons_ssg_filter 0; set PBX_Weapons_chaingun_filter 0; set PBX_Weapons_rocketlauncher_filter 0; set PBX_Weapons_plasmarifle_filter 0; set PBX_Weapons_bfg_filter 0;set PBX_Weapons_backpack_filter 0;set PBX_Weapons_monsterdrop_filter 0;set PBX_Weapons_specialdrop_filter 0; set PBX_WPEdit_SpawnFlags 0;"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBTOOLTIPS", "set pb_helpflags 0"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBX_Weapons_TOOLTIPS", "set PBX_Weapons_weaponTipFlags 0; set PBX_Weapons_upgradeTipFlags 0"
    StaticText "$PBX_Armament_Version",red
    StaticText " "
}

OptionMenu "PBX_Armament_Menu"
{
    Title "$PBX_Armament_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option "$PBX_Weapons_MENU_ENABLE_TOOLTIPS", "PBX_Weapons_sendTip", "OnOff","PBXCore_SendTip"
    Option "$PBX_Weapons_MENU_ENABLE_KEEPWEAPONS", "PBX_Weapons_keepweapons", "OnOff"
    StaticText " "
    SafeCommand "$PBX_Weapons_MENU_RESET_SPAWNERS", "set PBX_Weapons_chainsaw_filter 0; set PBX_Weapons_pistol_filter 0; set PBX_Weapons_shotgun_filter 0; set PBX_Weapons_ssg_filter 0; set PBX_Weapons_chaingun_filter 0; set PBX_Weapons_rocketlauncher_filter 0; set PBX_Weapons_plasmarifle_filter 0; set PBX_Weapons_bfg_filter 0;set PBX_Weapons_backpack_filter 0;set PBX_Weapons_monsterdrop_filter 0;set PBX_Weapons_specialdrop_filter 0; set PBX_WPEdit_SpawnFlags 0;"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBTOOLTIPS", "set pb_helpflags 0"
    SafeCommand "$PBX_Weapons_MENU_RESET_PBX_Weapons_TOOLTIPS", "set PBX_Weapons_weaponTipFlags 0; set PBX_Weapons_upgradeTipFlags 0"
    StaticText " "
    StaticText	"--------- Weapon Settings ---------", 1
    Option "$PBX_Weapons_START_WITH_BDP_RIFLE", "PBX_Weapons_startwithnormalrifle", "OnOff"
    Option "$PBX_Weapons_START_WITH_CROSSBOW", "PBX_Weapons_startwithcrossbow", "OnOff"
    Option "$PBX_Weapons_CSSG_LOCK_SWITCH", "PBX_Weapons_cssghooklockswitch", "OnOff"
    Option "$PBX_Weapons_LASER_SHOW_BEAM", "PBX_Weapons_lasershowbeam", "OnOff"
    StaticText " "
    Option "$PBX_Weapons_MENU_SECRETWEAPON_ENABLE", "PBX_Weapons_enablesecretweapon", "OnOff"
    Option "$PBX_Weapons_MENU_SECRETWEAPON_BFGSPAWN", "PBX_SecretWeapon_BFGSpawn", "OnOff"
    Slider "$PBX_Weapons_SECRETWEAPONS_SPAWNCHANCE",  "PBX_SecretWeapon_Chance",     1, 100, 1,0,"PBX_Weapons_enablesecretweapon"
    StaticText " "
    Slider "$PBX_Weapons_MEATHOOK_COOLDOWN",     "PBX_Weapons_meathook_cooldown",     1, 500, 1
    Slider "$PBX_Weapons_HOLOGRAM_COOLDOWN",     "PBX_Weapons_hologram_cooldown",     1, 500, 1
    Slider "$PBX_Weapons_HOLOGRAM_LIFETIME",     "PBX_Weapons_hologram_lifetime",     1, 500, 1
    SafeCommand "$PBX_Weapons_MENU_RESET_WEAPON_DURATIONS", "resetcvar PBX_SecretWeapon_Chance; resetcvar PBX_Weapons_meathook_cooldown; resetcvar PBX_Weapons_hologram_cooldown; resetcvar PBX_Weapons_hologram_lifetime"
    StaticText " "
    StaticText	"--------- Weapon Edits Settings ---------", 1
    Option "$PBX_MENU_WEAPONEDIT_ENABLE", "PBX_WPEdit_Enable", "OnOff"
    StaticText " "
    FlagOption    "$PBX_Weapons_SGL_EDIT",                       "PBX_WPEdit_SpawnFlags",   "OffOn", 0, "PBX_WPEdit_Enable"
	FlagOption    "$PBX_Weapons_LMG_EDIT",                       "PBX_WPEdit_SpawnFlags",   "OffOn", 1, "PBX_WPEdit_Enable"
	FlagOption    "$PBX_Weapons_CHAINSAW_EDIT",                  "PBX_WPEdit_SpawnFlags",   "OffOn", 2, "PBX_WPEdit_Enable"
    StaticText " "
    StaticText	"--------- Backpack Reload Settings ---------", 1
    Option "$PBX_MENU_BACKPACK_RELOAD_ENABLE", "PBX_BackpackReload_Enable", "OnOff"
    StaticText " "
    slider "$PBX_MENU_BACKPACK_RELOAD_FREQ",             "PBBCKPR_Time",1,350,5
    slider "$PBX_MENU_BACKPACK_RELOAD_AMOUNT",                "PBBCKPR_Ref",1,10,1
    option "$PBX_MENU_BACKPACK_RELOAD_ANNOUNCE",              "PBBCKPR_Tell","yesno"

    StaticText " "
    StaticText "$PBX_Armament_Version",red
}


