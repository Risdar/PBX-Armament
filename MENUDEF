    Option  "$PBX_MODULE_ARMORS", "PBX_MODULE_ARMORS", "OnOff"
    Option  "$PBX_MODULE_POWERUPS", "PBX_MODULE_POWERUPS", "OnOff"
    Option  "$PBX_MODULE_ITEMS", "PBX_MODULE_ITEMS", "OnOff"
