    StaticText " "
    StaticText	"--------- Secret Weapons ---------", 1
    FlagOption    "$PBX_WEAPONS_ETERNAL_CHAINGUN",   "PBX_SPAWN_FLAGS_SECRET_WEAPONS",    "OffOn", 0, "PBX_MODULE_WEAPONS"
    FlagOption    "$PBX_WEAPONS_NUKE_LAUNCHER",      "PBX_SPAWN_FLAGS_SECRET_WEAPONS",    "OffOn", 1, "PBX_MODULE_WEAPONS" 
    FlagOption    "$PBX_WEAPONS_HEXA_SHOTGUN",       "PBX_SPAWN_FLAGS_SECRET_WEAPONS",    "OffOn", 2, "PBX_MODULE_WEAPONS" 
    FlagOption    "$PBX_WEAPONS_MINI_SHOTGUN",       "PBX_SPAWN_FLAGS_SECRET_WEAPONS",    "OffOn", 3, "PBX_MODULE_WEAPONS" 
    FlagOption    "$PBX_WEAPONS_RIPPER_CHAINGUN",    "PBX_SPAWN_FLAGS_SECRET_WEAPONS",    "OffOn", 4, "PBX_MODULE_WEAPONS" 
    StaticText " "
    StaticText	"--------- Monster Weapons ---------", 1
    FlagOption    "$PBX_WEAPONS_CYBERRL",        "PBX_SPAWN_FLAGS_MONSTER_WEAPONS",    "OffOn", 0, "PBX_MODULE_WEAPONS"
    FlagOption    "$PBX_WEAPONS_SPIDERCG",       "PBX_SPAWN_FLAGS_MONSTER_WEAPONS",    "OffOn", 1, "PBX_MODULE_WEAPONS"
    FlagOption    "$PBX_WEAPONS_GRABCACO",       "PBX_SPAWN_FLAGS_MONSTER_WEAPONS",    "OffOn", 2, "PBX_MODULE_WEAPONS"
    StaticText " "
    StaticText	"--------- Others ---------", 1
    FlagOption    "$PBX_WEAPONS_SPECOPSPACK",               "PBX_SPAWN_FLAGS_BACKPACK",    "OffOn", 11, "PBX_MODULE_WEAPONS"
    FlagOption    "$PBX_WEAPONS_UAC_COMMANDER_BACKPACK",    "PBX_SPAWN_FLAGS_BACKPACK",    "OffOn", 4, "PBX_MODULE_WEAPONS"
}

